AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
OPENSEARCH_ENDPOINT=https://your-opensearch-domain.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=iac-security-kb
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_password_here
S3_REPORTS_BUCKET=iac-security-reports
S3_TEMPLATES_BUCKET=iac-security-templates
LOG_LEVEL=INFO
MAX_RAG_RESULTS=5
VULNERABILITY_CONFIDENCE_THRESHOLD=0.7
REPORT_OUTPUT_DIR=data/reports/generated
