# =============================================================================
# LLM IaC Security Scanner - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# MODE controls which backend to use:
#   aws   = Amazon Bedrock + Pinecone + Titan Embeddings (recommended)
#   local = Ollama + ChromaDB + HuggingFace (optional local mode)
# =============================================================================

MODE=aws

# =============================================================================
# Local Mode Settings (free — requires Ollama running locally)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.0

# Local vector store (ChromaDB — stores data in a local directory)
CHROMA_PERSIST_DIR=.chroma_db
CHROMA_COLLECTION=iac-security-kb

# Local embedding model (HuggingFace — downloaded automatically on first run)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# AWS Mode Settings (paid — requires AWS account with Bedrock access)
# =============================================================================
AWS_REGION=us-west-2
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset to use your configured
# AWS CLI credentials by default. Only set them here if you need to override.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# Amazon Bedrock LLM
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Pinecone vector store
PINECONE_API_KEY=replace-with-rotated-pinecone-key
PINECONE_INDEX=iac-security-kb

# S3 storage (optional — for storing reports in the cloud)
S3_REPORTS_BUCKET=iac-security-reports
S3_TEMPLATES_BUCKET=iac-security-templates

# =============================================================================
# Common Settings
# =============================================================================
LOG_LEVEL=INFO
MAX_RAG_RESULTS=5
VULNERABILITY_CONFIDENCE_THRESHOLD=0.7
REPORT_OUTPUT_DIR=data/reports/generated
