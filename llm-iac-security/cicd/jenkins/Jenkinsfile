pipeline {
    agent any

    parameters {
        choice(name: 'MODE', choices: ['local', 'aws'], description: 'Run mode: local (Ollama+ChromaDB) or aws (Bedrock+Pinecone)')
    }

    environment {
        MODE = "${params.MODE}"
    }

    stages {
        stage("Setup") {
            steps {
                sh "pip install -r requirements.txt"
            }
        }

        stage("Lint & Test") {
            steps {
                sh "flake8 . --max-line-length=120 --exclude=venv,env,.venv"
                sh "pytest tests/unit/ -v"
            }
        }

        stage("IaC Security Scan") {
            steps {
                script {
                    if (params.MODE == 'aws') {
                        withCredentials([
                            usernamePassword(credentialsId: "aws-credentials",
                                usernameVariable: "AWS_ACCESS_KEY_ID",
                                passwordVariable: "AWS_SECRET_ACCESS_KEY"),
                            string(credentialsId: "pinecone-api-key",
                                variable: "PINECONE_API_KEY")
                        ]) {
                            sh '''
                                for t in tests/fixtures/templates/T*.yaml; do
                                    echo "Scanning: $t"
                                    python scripts/run_scan.py "$t" --mode aws || true
                                done
                            '''
                        }
                    } else {
                        sh '''
                            for t in tests/fixtures/templates/T*.yaml; do
                                echo "Scanning: $t"
                                python scripts/run_scan.py "$t" --mode local || true
                            done
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "data/reports/generated/*.md", allowEmptyArchive: true
            junit allowEmptyResults: true, testResults: "**/test-results/*.xml"
        }
    }
}
